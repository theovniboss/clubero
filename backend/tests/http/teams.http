@baseUrl = http://localhost:3030/api


### Teams API tests
GET http://localhost:3030/api/teams/all
Authorization: Bearer {{token}}

###
# Get teams CreateBy current user
GET http://localhost:3030/api/teams
Authorization: Bearer {{token}}

###
# Get teams by current user
GET http://localhost:3030/api/user/teams
Authorization: Bearer {{token}}


###
# Get a team by id
GET http://localhost:3030/api/team/2
Authorization: Bearer {{token}}

###
# Invite Users 
POST  http://localhost:3030/api/team/1/invite
Content-Type: application/json
Authorization: Bearer {{token}}


{
	"users": [
	{
		"name":"Anderson Peter",
		"nickname":"Peter",
		"email":"ltesta.kop@gmail.com"
	}]
}	






###
# Get a team by id with users
GET http://localhost:3030/api/team/1/users
Authorization: Bearer {{token}}

###
# Create a team
POST {{baseUrl}}/team
Content-Type: application/json
Authorization: Bearer {{token}}

{
	"clubId": 1,
	"sportId": 1,
	"name": "Adulto Masculino",
	"gender": "MALE",
	"category": "Adulto",
	"active": true	
}

###
# Update a team
PUT {{baseUrl}}/team/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
	"sportId": 1,
	"name": "Adulto Feminino",
	"description": "Time feminino adulto de Futebol Americano",
	"image": null,
	"gender": "FEMALE",
	"category": "Adulto",
	"active": true

}

###
# Delete a team
DELETE {{baseUrl}}/team/4
Authorization: Bearer {{token}}

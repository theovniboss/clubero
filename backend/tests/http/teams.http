# Get all teams (unfiltered)
GET http://localhost:3030/api/teams/all
Authorization: Bearer {{token}}

###
# Get teams by current user
GET http://localhost:303/api/teams
Authorization: Bearer {{token}}

###
# Get a team by id
GET http://localhost:3030/api/team/1
Authorization: Bearer {{token}}

###
# Create a team
POST http://localhost:3030/api/team
Content-Type: application/json
Authorization: Bearer {{token}}

{
	"clubId": 1,
	"sportId": 2,
	"name": "Adulto Masculino",
	"gender": "MALE",
	"category": "Adulto",
	"active": true	
}

###
# Update a team
PUT http://localhost:3030/api/team/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
	"sportId": 1,
	"name": "Adulto Feminino",
	"description": "Time feminino adulto de Futebol Americano",
	"image": null,
	"gender": "FEMALE",
	"category": "Adulto",
	"active": true

}

###
# Delete a team
DELETE http://localhost:3030/api/team/1
Authorization: Bearer {{token}}

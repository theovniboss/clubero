###
# Create a team
POST http://localhost:3030/api/team
Content-Type: application/json
Authorization: Bearer {{token}}

{
	"clubId": 1,
	"sportId": 1,
	"name": "Feminino infantil",
	"gender": "FEMALE",
	"category": "Infantil",
	"active": true	
}

###
# Update a team
PUT http://localhost:3030/api/team/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
	"sportId": 1,
	"name": "Adulto Feminino",
	"description": "Time feminino adulto de Futebol Americano",
	"image": null,
	"gender": "FEMALE",
	"category": "Adulto",
	"active": true

}


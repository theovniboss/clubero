@baseUrl = http://localhost:3030/api


### Get all clubs
GET {{baseUrl}}/clubs/all
Authorization: Bearer {{ token }}

### Get all clubs
GET {{baseUrl}}/clubs 
Authorization: Bearer {{ token }}

### Get user by ID
GET {{baseUrl}}/club/1 
Authorization: Bearer {{ token }}


### Create a new Club
POST {{baseUrl}}/club
Content-Type: application/json
Authorization: Bearer {{ token }}

{
    "name": "Crimson Fox",
    "description": "Melhor Clube de Flag Footbal de São Paulo",
    "image": "",
    "country": "Brasil",
    "state": "SP",
    "city": "São Paulo",
    "founded": "2017-09-01T00:00:00Z",
    "active": true
}

### Update user by ID
PUT {{baseUrl}}/club/1
Authorization: Bearer {{ token }}
Content-Type: application/json

{
    "name": "Crimson Fox",
    "description": "El mejor club del mundo",
    "image": "https://clubero.com/logo.png",
    "country": "Brasil",
    "state": "São Paulo",
    "city": "São Paulo",
    "founded": "2017-01-01T00:00:00Z",
    "active": true
}


### Delete user by ID
DELETE {{baseUrl}}/club/2
Authorization: Bearer {{ token }}


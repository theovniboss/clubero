@baseUrl = http://localhost:3030/api

### Get all events for a club
GET {{baseUrl}}/club/1/events
Authorization: Bearer {{token}}

### Get all events for a team in a club
GET {{baseUrl}}/club/1/events?teamId=1
Authorization: Bearer {{token}}


### Get event by ID
GET {{baseUrl}}/event/1
Authorization: Bearer {{token}}

### Create a new Event
POST {{baseUrl}}/event
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "title": "Reunião de menbris",
    "description": "Reunião para falar sobre como será 2026",
    "start": "2025-12-14T18:00:00Z",
    "end": "2025-12-14T20:00:00Z",
    "location": "Casa",
    "type": "SOCIAL",
    "clubId": 1
}

### Update event by ID
PUT {{baseUrl}}/event/3
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "Reunião de menbros"
}

### Delete event by ID
DELETE {{baseUrl}}/event/4
Authorization: Bearer {{token}}

### Listar todos os participantes de um evento específico
GET {{baseUrl}}/event/1/participants
Authorization: Bearer {{token}}


### Adicionar um ou mais participantes a um evento
POST {{baseUrl}}/event/1/participants
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "participants": [
		{"userId":"auth0|653488429b0572863890e12f"}
    ]
}

### // Atualizar o status de um participante (o usuário logado atualiza o seu próprio status)
PUT {{baseUrl}}/event/1/participants/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "status": "GOING"
}


### Remover um ou mais participantes de um evento
DELETE {{baseUrl}}/event/1/participants
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "participants": [
        {"userId":"auth0|653488429b0572863890e12e"},
       	{"userId":"auth0|653488429b0572863890e12f"}
    ]
}

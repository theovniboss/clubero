generator client {
    provider = "prisma-client"
    output   = "../database/generated/prisma"
    runtime  = "bun"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Club {
    id          Int       @id @default(autoincrement())
    name        String
    description String?
    image       String?
    country     String
    state       String
    city        String
    founded     DateTime
    active      Boolean   @default(false)
    createdBy   String
    createdAt   DateTime  @default(now())
    updatedBy   String?
    updatedAt   DateTime? @updatedAt
    teams       Team[]
    categories  CashFlowCategory[]
    cashFlows   CashFlow[]
}

model Sport {
    id    Int     @id @default(autoincrement())
    name  String
    image String?
    teams Team[]
}

model Team {
    id          Int        @id @default(autoincrement())
    clubId      Int
    sportId     Int
    name        String
    description String?
    image       String?
    gender      Gender?
    category    String?
    active      Boolean    @default(false)
    createdBy   String
    createdAt   DateTime   @default(now())
    updatedBy   String?
    updatedAt   DateTime?  @updatedAt
    club        Club       @relation(fields: [clubId], references: [id])
    sport       Sport      @relation(fields: [sportId], references: [id])
    teamUser    TeamUser[]
    cashFlows   CashFlow[]
}

model TeamUser {
    userId String
    teamId Int
    active Boolean
    team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@id([userId, teamId])
}

model CashFlowCategory {
    id        Int          @id @default(autoincrement())
    name      String
    type      CashFlowType
    clubId    Int? // Optional: if NULL, it's a global category
    club      Club?        @relation(fields: [clubId], references: [id])
    createdBy String
    createdAt DateTime     @default(now())
    updatedBy String?
    updatedAt DateTime?    @updatedAt
    cashFlows CashFlow[]

    @@unique([clubId, name, type])
}

model CashFlow {
    id          BigInt               @id @default(autoincrement())
    description String
    amount      Int
    type        CashFlowType
    occurredAt  DateTime
    clubId      Int
    club        Club              @relation(fields: [clubId], references: [id])
    teamId      Int?
    team        Team?             @relation(fields: [teamId], references: [id])
    categoryId  Int?
    category    CashFlowCategory? @relation(fields: [categoryId], references: [id])
    createdBy   String
    createdAt   DateTime          @default(now())
    updatedBy   String?
    updatedAt   DateTime?         @updatedAt
}

enum Gender {
    MALE
    FEMALE
    MIXED
}

enum CashFlowType {
    CREDIT
    DEBIT
}

generator client {
    provider = "prisma-client"
    output   = "../database/generated/prisma"
    runtime  = "bun"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Club {
    id          Int       @id @default(autoincrement())
    name        String
    description String?
    image       String?
    country     String
    state       String
    city        String
    founded     DateTime
    active      Boolean   @default(false)
    createdBy   String
    createdAt   DateTime  @default(now())
    updatedBy   String?
    updatedAt   DateTime? @updatedAt
    teams       Team[]
}

model Sport {
    id    Int     @id @default(autoincrement())
    name  String
    image String?
    teams Team[]
}

model Team {
    id          Int        @id @default(autoincrement())
    clubId      Int
    sportId     Int
    name        String
    description String?
    image       String?
    gender      Gender?
    category    String?
    active      Boolean    @default(false)
    createdBy   String
    createdAt   DateTime   @default(now())
    updatedBy   String?
    updatedAt   DateTime?  @updatedAt
    club        Club       @relation(fields: [clubId], references: [id])
    sport       Sport      @relation(fields: [sportId], references: [id])
    teamUser    TeamUser[]
}

model TeamUser {
    userId String
    teamId Int
    active Boolean
    team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@id([userId, teamId])
}


enum Gender {
    MALE
    FEMALE
    MIXED
}

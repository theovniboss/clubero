
generator client {
    provider = "prisma-client"
    output   = "../../database/generated/mongodb"
    runtime  = "bun"
}

datasource db {
    provider = "mongodb"
    url      = env("MONGODB_URL")
}

model ChatMessage {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    content   String
    createdAt DateTime @default(now())
    // IDs para relacionar com os dados no banco SQL
	clubId    Int
    teamId    Int?   
    userId    String
    userName  String   

    @@index([clubId, teamId, createdAt])
}


generator client {
    provider = "prisma-client"
    output   = "../../database/generated/sqlite"
    runtime  = "bun"
}

datasource db {
    provider = "sqlite"
    url      = env("SQLITE_URL")
}

model Club {
    id          Int       @id @default(autoincrement())
    name        String
    description String?
    image       String?
    country     String
    state       String
    city        String
    founded     DateTime
    active      Boolean   @default(false)
    createdBy   String
    createdAt   DateTime  @default(now())
    updatedBy   String?
    updatedAt   DateTime? @updatedAt
    teams       Team[]
    categories  CashFlowCategory[]
    cashFlows   CashFlow[]
    events      Event[]
}

model Sport {
    id    Int     @id @default(autoincrement())
    name  String
    image String?
    teams Team[]
}

model Team {
    id          Int        @id @default(autoincrement())
    clubId      Int
    sportId     Int
    name        String
    description String?
    image       String?
    gender      Gender?
    category    String?
    active      Boolean    @default(false)
    createdBy   String
    createdAt   DateTime   @default(now())
    updatedBy   String?
    updatedAt   DateTime?  @updatedAt
    club        Club       @relation(fields: [clubId], references: [id])
    sport       Sport      @relation(fields: [sportId], references: [id])
    teamUser    TeamUser[]
    cashFlows   CashFlow[] 
    events      Event[]
}

model TeamUser {
    userId String
    teamId Int
    active Boolean
    team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@id([userId, teamId])
}

model CashFlowCategory {
    id        Int          @id @default(autoincrement())
    name      String
    type      CashFlowType
    clubId    Int? // Optional: if NULL, it's a global category
    club      Club?        @relation(fields: [clubId], references: [id])
    createdBy String
    createdAt DateTime     @default(now())
    updatedBy String?
    updatedAt DateTime?    @updatedAt
    cashFlows CashFlow[]
}

model CashFlow {
    id          Int           @id @default(autoincrement())
    description String
    amount      Int
    occurredAt  DateTime
    clubId      Int
    club        Club              @relation(fields: [clubId], references: [id])
    teamId      Int?
    team        Team?             @relation(fields: [teamId], references: [id])
    categoryId  Int
    category    CashFlowCategory @relation(fields: [categoryId], references: [id])
    createdBy   String
    createdAt   DateTime          @default(now())
    updatedBy   String?
    updatedAt   DateTime?         @updatedAt
}

model Event {
    id          Int       @id @default(autoincrement())
    title       String
    description String?
    start       DateTime
    end         DateTime
    location    String?
    type        EventType @default(OTHER)
    createdBy   String
    createdAt   DateTime  @default(now())
    updatedBy   String?
    updatedAt   DateTime? @updatedAt
    recurrenceId      String?   // Common ID for all events in a series (e.g., a UUID)
    recurrenceRule    String?   // Stores the recurrence rule (e.g., RRULE string from iCal)

    clubId      Int
    club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

    // Um evento pode ser de um time específico ou do clube em geral (teamId opcional)
    teamId      Int?
    team        Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

    participants EventParticipant[]

    @@index([recurrenceId])
    @@index([clubId, start, end])
}

model EventParticipant {
    eventId   Int
    event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
    userId    String
    status    EventConfirmationStatus @default(MAYBE)
    checkedIn Boolean                 @default(false)
	checkedInBy String?
	checkedInAt DateTime?
    createdAt DateTime                @default(now())
	createdBy String
    updatedAt DateTime                @updatedAt
	updatedBy String?

    @@id([eventId, userId])
}

enum Gender {
    MALE
    FEMALE
    MIXED
}

enum CashFlowType {
    CREDIT
    DEBIT
}

enum EventType {
    TRAINING // Treino
    MATCH    // Jogo/Partida
    MEETING  // Reunião
    SOCIAL   // Evento Social
    OTHER    // Outro
}


enum EventConfirmationStatus {
    GOING
    NOT_GOING
    MAYBE
}
